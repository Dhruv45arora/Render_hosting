# Neon PostgreSQL (or any Postgres). Never commit a real password URL.
# Copy to `.env` and paste the connection string from the Neon / host dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-password"
# CEO / site-renter desk — bookings, fleet cards, contact numbers (no SEO/blogs)
DEV_USER="developer"
DEV_PASSWORD="change-this-dev-password"
AUTH_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://aroracars.com"
PORT=3000
